<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="EBToolbox.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:EBToolbox.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:EBToolbox"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="EBOS Toolbox"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop Kind="Base" />
    </Window.SystemBackdrop>
    <Grid x:Name="RootGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TitleBar
            x:Name="AppTitleBar"
            Grid.Column="1"
            Height="{Binding ElementName=NavigationViewControl, Path=CompactPaneLength}"
            Margin="48,0,0,0"
            VerticalAlignment="Stretch"
            IsPaneToggleButtonVisible="True"
            PaneToggleRequested="AppTitleBar_PaneToggleRequested"
            AutomationProperties.AutomationId="AppTitleBar"
            Canvas.ZIndex="1">
            <TitleBar.LeftHeader>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button
                        x:Name="EBButton"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        Click="EBButton_Click"
                        CornerRadius="6"
                        ToolTipService.ToolTip="EB Toolbox - 10 clicks for easter egg">
                        <Image
                            Width="20"
                            Height="20"
                            VerticalAlignment="Center"
                            Source="ms-appx:///assets/logo/eb-logo.png" />
                    </Button>
                    <StackPanel Orientation="Vertical" VerticalAlignment="Center" Spacing="0">
                        <TextBlock
                            x:Name="AppTitle"
                            Margin="8,-2,0,0"
                            VerticalAlignment="Center"
                            FontWeight="SemiBold"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="EB Toolbox" />
                        <TextBlock
                            Margin="8,0,0,0"
                            FontSize="9"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Opacity="0.8"
                            Text="EBOS EDITION" />
                    </StackPanel>
                </StackPanel>
            </TitleBar.LeftHeader>
            <TitleBar.Content>
                <AutoSuggestBox
                    x:Name="SearchBox"
                    Width="340"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="EB Search"
                    CornerRadius="8"
                    PlaceholderText="Search settings..."
                    QueryIcon="Find"
                    SuggestionChosen="AutoSuggestBox_SuggestionChosen"
                    TextChanged="AutoSuggestBox_TextChanged">
                    <AutoSuggestBox.Resources>
                        <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
                    </AutoSuggestBox.Resources>
                </AutoSuggestBox>
            </TitleBar.Content>
        </TitleBar>
        <NavigationView
            x:Name="NavigationViewControl"
            Grid.RowSpan="2"
            Grid.Column="1"
            AlwaysShowHeader="True"
            BackRequested="NavigationViewControl_BackRequested"
            IsPaneToggleButtonVisible="False"
            Header="EB Toolbox"
            IsSettingsVisible="False"
            IsTabStop="False"
            IsTitleBarAutoPaddingEnabled="False"
            PaneDisplayMode="Left"
            SelectionChanged="NavigationViewControl_SelectionChanged">
            <!--Main Content-->
            <NavigationView.Content>
                <Grid>
                    <Frame x:Name="ContentFrame" Navigated="ContentFrame_Navigated" />
                    <InfoBar
                        x:Name="UpdateTitleBar"
                        Margin="0,26,36,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        IsOpen="False">
                        <InfoBar.ActionButton>
                            <HyperlinkButton x:Name="LearnMoreBtn" NavigateUri="https://github.com/EhabYT/EB-Toolbox/releases/latest" />
                        </InfoBar.ActionButton>
                    </InfoBar>
                </Grid>
            </NavigationView.Content>
            <NavigationView.Resources>
                <Thickness x:Key="NavigationViewContentMargin">0,48,0,0</Thickness>
                <Thickness x:Key="NavigationViewMinimalContentMargin">0,48,0,0</Thickness>
                <Thickness x:Key="NavigationViewContentGridBorderThickness">1,1,0,0</Thickness>
                <CornerRadius x:Key="NavigationViewContentGridCornerRadius">8,0,0,0</CornerRadius>
            </NavigationView.Resources>

            <!--  Currently an experiment  -->
            <!--<NavigationView.AutoSuggestBox>
                <AutoSuggestBox
                    x:Name="SearchBox"
                    AutomationProperties.Name="Basic AutoSuggestBox"
                    QueryIcon="Find"
                    SuggestionChosen="AutoSuggestBox_SuggestionChosen"
                    TextChanged="AutoSuggestBox_TextChanged" />
            </NavigationView.AutoSuggestBox>-->

            <NavigationView.MenuItems>
                <NavigationViewItem
                    x:Name="Home"
                    Icon="Home"
                    Tag="EBToolbox.Views.HomePage" />
                <NavigationViewItem x:Name="Software" Tag="EBToolbox.Views.SoftwarePage">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE896;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItemSeparator />
                <NavigationViewItem x:Name="GeneralConfig" Tag="General">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xF259;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="Interface" Tag="Interface">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE932;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="Windows" Tag="Windows">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE977;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="Advanced" Tag="Advanced">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xEC7A;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="Security" Tag="Security">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE83D;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="Troubleshooting" Tag="Troubleshooting">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7BA;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem
                    x:Name="Setting"
                    Icon="Setting"
                    Tag="SettingsPage" />
            </NavigationView.FooterMenuItems>
        </NavigationView>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="TitleBarStates">
                <VisualState x:Name="Default" />
                <VisualState x:Name="Compact">
                    <VisualState.Setters>
                        <Setter Target="AppTitleBar.Margin" Value="96,0,0,0" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Top">
                    <VisualState.Setters>
                        <Setter Target="AppTitleBar.Margin" Value="16,0,0,0" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
            <VisualStateGroup x:Name="WindowActivationStates">
                <VisualState x:Name="Activated" />
                <VisualState x:Name="Deactivated">
                    <VisualState.Setters>
                        <Setter Target="AppTitle.Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </Grid>
</Window>
