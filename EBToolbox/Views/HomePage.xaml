<Page
    x:Class="EBToolbox.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:control="using:CommunityToolkit.WinUI.Controls"
    xmlns:controls="using:EBToolbox.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:EBToolbox.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:model="using:EBToolbox.Models"
    xmlns:ui="using:CommunityToolkit.WinUI"
    xmlns:viewmodel="using:EBToolbox.ViewModels"
    d:DataContext="{d:DesignInstance Type=viewmodel:HomePageViewModel}"
    mc:Ignorable="d">
    <Page.Resources>
        <local:FontIconConverter x:Key="FontIconConverter" />
    </Page.Resources>
    <ScrollViewer>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.6*" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <GridView
                x:Name="itemGridView"
                Grid.Row="0"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                Margin="-40,-50,0,0"
                HorizontalAlignment="Center"
                IsItemClickEnabled="True"
                IsSwipeEnabled="False"
                SelectionMode="None">
                <GridView.Header>
                    <Grid x:Name="HeaderGrid" Margin="0,50,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="204" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <controls:HomePageHeaderImage
                            Grid.RowSpan="2"
                            Height="396"
                            VerticalAlignment="Top" />

                        <StackPanel
                            Margin="75,0,0,0"
                            VerticalAlignment="Center"
                            Orientation="Vertical"
                            Spacing="4">
                            <Border
                                Padding="8,3"
                                HorizontalAlignment="Left"
                                Background="{ThemeResource SystemAccentColor}"
                                CornerRadius="6"
                                Opacity="0.9">
                                <TextBlock
                                    x:Name="subHeaderBlock"
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    Foreground="White"
                                    Text="EBOS TOOLBOX" />
                            </Border>
                            <TextBlock
                                x:Name="HomeHeaderText"
                                FontSize="42"
                                FontWeight="Bold"
                                TextWrapping="Wrap" />
                            <TextBlock
                                Margin="0,4,0,0"
                                MaxWidth="480"
                                FontSize="13"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Opacity="0.85"
                                Text="Tweak Windows, manage profiles and optimize your EBOS experience."
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <controls:TileGallery
                            x:Name="headerTileGallery"
                            Grid.Row="1"
                            Margin="40,0,0,0" />
                    </Grid>
                </GridView.Header>
            </GridView>
            <StackPanel
                x:Name="ProfilesPanel"
                Grid.Row="1"
                Grid.Column="1"
                Margin="16,5,0,0"
                Spacing="8">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon
                        FontSize="16"
                        Foreground="{StaticResource EBAccentBrush}"
                        Glyph="&#xE736;" />
                    <TextBlock x:Name="ProfilesHeader" FontSize="18" FontWeight="SemiBold" />
                </StackPanel>
                <Border
                    Padding="4"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Margin="0,4,36,10">
                    <Border.Shadow>
                        <ThemeShadow />
                    </Border.Shadow>
                    <ListView
                    x:Name="ProfilesListView"
                    Grid.Row="1"
                    Grid.Column="1"
                    Height="225"
                    VerticalAlignment="Top"
                    Background="{ThemeResource ControlFillColorDefault}"
                    CornerRadius="{StaticResource OverlayCornerRadius}"
                    SelectedItem="{Binding ProfileSelected, Mode=TwoWay}">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="model:Profiles">
                                <Grid>
                                    <Grid.ContextFlyout>
                                        <MenuFlyout x:Name="MenuFlyout">
                                            <MenuFlyoutItem
                                            x:Name="SetProfile"
                                            Click="SetProfile_Click"
                                            Loaded="SetProfile_Loaded" />
                                            <MenuFlyoutItem
                                            x:Name="DeleteProfile"
                                            Click="DeleteProfile"
                                            Loaded="DeleteProfile_Loaded" />
                                        </MenuFlyout>
                                    </Grid.ContextFlyout>
                                    <TextBlock Text="{x:Bind Name}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Border>
                <Button
                    x:Name="NewProfileButton"
                    VerticalAlignment="Top"
                    Click="Button_Click" />
            </StackPanel>
            <StackPanel
                Grid.Row="1"
                Grid.Column="0"
                Margin="36,5,0,0"
                Orientation="Horizontal"
                Spacing="8">
                <FontIcon
                    FontSize="16"
                    Foreground="{StaticResource EBAccentBrush}"
                    Glyph="&#xEB51;" />
                <TextBlock x:Name="FavoritesHeader" FontSize="18" FontWeight="SemiBold" />
            </StackPanel>
            <Grid
                x:Name="FavoritesPanel"
                Grid.Row="1"
                Grid.Column="0"
                MinHeight="300"
                Margin="0,36,0,0">
                <Grid.Background>
                    <SolidColorBrush Color="Transparent" />
                </Grid.Background>
                <Grid.Resources>
                    <DataTemplate x:Key="ControlItemTemplate" x:DataType="viewmodel:ConfigurationItemViewModel">
                        <control:SettingsCard
                            x:Name="SettingsCard"
                            MinHeight="74"
                            Margin="36,0,36,10"
                            Header="{Binding Name}"
                            Style="{StaticResource ConfigurationSettingsCardTemplate}">
                            <control:SettingsCard.ContextFlyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem
                                        Click="MenuFlyoutItem_Click"
                                        Tag="{Binding Key}"
                                        Text="Remove" />
                                </MenuFlyout>
                            </control:SettingsCard.ContextFlyout>
                            <ToggleSwitch
                                x:Name="ConfigSwitch"
                                IsOn="{Binding CurrentSetting}"
                                Loaded="ToggleSwitch_Loaded" />
                        </control:SettingsCard>
                    </DataTemplate>
                    <DataTemplate x:Key="MultiOptionControlTemplate" x:DataType="viewmodel:MultiOptionConfigurationItemViewModel">
                        <control:SettingsCard
                            Height="74"
                            Margin="36,0,36,10"
                            Header="{Binding Name}"
                            Style="{StaticResource ConfigurationSettingsCardTemplate}">
                            <control:SettingsCard.ContextFlyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem
                                        Click="MenuFlyoutItem_Click"
                                        Tag="{Binding Key}"
                                        Text="Remove" />
                                </MenuFlyout>
                            </control:SettingsCard.ContextFlyout>
                            <ComboBox
                                x:Name="ConfigSwitch"
                                Width="200"
                                ItemsSource="{Binding Options}"
                                SelectedItem="{Binding CurrentSetting, Mode=TwoWay}" />
                        </control:SettingsCard>
                    </DataTemplate>
                    <DataTemplate x:Key="ConfigurationButtonTemplate" x:DataType="viewmodel:ConfigurationButtonViewModel">
                        <control:SettingsCard
                            x:Name="SettingsCard"
                            Height="74"
                            Margin="36,0,36,10"
                            Header="{Binding Description}"
                            Style="{StaticResource ConfigurationSettingsCardTemplate}">
                            <control:SettingsCard.ContextFlyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem
                                        Click="MenuFlyoutItem_Click"
                                        Tag="{Binding Key}"
                                        Text="Remove" />
                                </MenuFlyout>
                            </control:SettingsCard.ContextFlyout>
                            <Button
                                Command="{Binding ExecuteCommandCommand}"
                                Content="{Binding Name}"
                                Style="{StaticResource AccentButtonStyle}" />
                        </control:SettingsCard>
                    </DataTemplate>
                    <DataTemplate x:Key="LinksTemplate" x:DataType="viewmodel:LinksViewModel">
                        <control:SettingsCard
                            x:Name="LinkCard"
                            Height="74"
                            Margin="36,0,36,10"
                            ActionIcon="{ui:FontIcon Glyph=&#xE8A7;}"
                            ActionIconToolTip="Open in new window"
                            Click="LinkCard_Click"
                            Header="{Binding Name}"
                            HeaderIcon="{Binding FontIcon, Converter={StaticResource FontIconConverter}}"
                            IsClickEnabled="True"
                            Style="{StaticResource ConfigurationSettingsCardTemplate}">
                            <control:SettingsCard.ContextFlyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem
                                        Click="MenuFlyoutItem_Click"
                                        Tag="{Binding Key}"
                                        Text="Remove" />
                                </MenuFlyout>
                            </control:SettingsCard.ContextFlyout>
                        </control:SettingsCard>
                    </DataTemplate>
                    <local:FavoriteItemDataTemplateSelector
                        x:Key="FavoriteItemDataTemplateSelector"
                        ConfiguartionLink="{StaticResource LinksTemplate}"
                        ConfigurationButton="{StaticResource ConfigurationButtonTemplate}"
                        ConfigurationItem="{StaticResource ControlItemTemplate}"
                        MultiOptionConfigurationItem="{StaticResource MultiOptionControlTemplate}" />
                </Grid.Resources>
                <ItemsControl
                    x:Name="FavoritesControl"
                    ItemTemplateSelector="{StaticResource FavoriteItemDataTemplateSelector}"
                    ItemsSource="{x:Bind _configurationItems, Mode=OneWay}" />
                <TextBlock
                    x:Name="NoFavoritesText"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="20"
                    Foreground="{StaticResource TextFillColorTertiary}" />
            </Grid>
        </Grid>
    </ScrollViewer>
</Page>