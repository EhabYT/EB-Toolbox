<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="EBToolbox.SoftwarePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:EBToolbox.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="using:CommunityToolkit.WinUI"
    xmlns:viewmodel="using:EBToolbox.ViewModels"
    d:DataContext="{d:DesignInstance Type=viewmodel:SoftwarePageViewModel}"
    mc:Ignorable="d">
    <Page.Resources>
        <local:BitmapIconConverter x:Key="BitmapIconConverter" />
    </Page.Resources>
    <Grid Margin="36,0,24,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="auto" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,16,0,16" Spacing="6">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <FontIcon
                    FontSize="20"
                    Foreground="{StaticResource EBAccentBrush}"
                    Glyph="&#xE896;" />
                <TextBlock
                    x:Name="TitleTxt"
                    VerticalAlignment="Center"
                    FontSize="24"
                    FontWeight="SemiBold"
                    Style="{StaticResource TitleTextBlockStyle}" />
                <Border
                    Padding="6,2"
                    VerticalAlignment="Center"
                    Background="{StaticResource EBPrimaryLightBrush}"
                    CornerRadius="6">
                    <TextBlock
                        FontSize="10"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource EBPrimaryBrush}"
                        Text="WINGET" />
                </Border>
            </StackPanel>
            <TextBlock
                FontSize="13"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Opacity="0.85"
                Text="Select apps to install via WinGet. Checked items will be installed on next action."
                TextWrapping="Wrap" />
        </StackPanel>
        <Grid Grid.Row="1">
            <ScrollViewer
                Padding="0,0,12,0"
                VerticalScrollBarVisibility="Auto"
                VerticalAlignment="Stretch">
                <StackPanel Spacing="2">
                    <ItemsControl ItemsSource="{Binding SoftwareItemViewModels}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <controls:SettingsCard
                                    x:Name="SettingsCard"
                                    Margin="0,0,0,6"
                                    HorizontalContentAlignment="Right"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    Header="{Binding Name}"
                                    HeaderIcon="{Binding BitMapIcon, Converter={StaticResource BitmapIconConverter}}"
                                    CornerRadius="8"
                                    Style="{StaticResource ConfigurationSettingsCardTemplate}">
                                    <CheckBox
                                        MinWidth="0"
                                        Margin="0"
                                        Checked="CheckBox_Checked"
                                        Unchecked="CheckBox_Unchecked" />
                                </controls:SettingsCard>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>
        <Grid
            Grid.Row="2"
            Margin="0,12,0,16"
            ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel
                x:Name="ProgressRingStackPanel"
                Grid.Column="0"
                VerticalAlignment="Center"
                Orientation="Vertical"
                Spacing="6"
                Visibility="Collapsed">
                <TextBlock
                    x:Name="CurrentlyInstalling"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextAlignment="Left"
                    TextWrapping="Wrap" />
                <ProgressBar
                    x:Name="DownloadingProgressBar"
                    MinWidth="200"
                    HorizontalAlignment="Stretch" />
            </StackPanel>
            <Button
                x:Name="InstallButton"
                Grid.Column="1"
                MinWidth="140"
                VerticalAlignment="Center"
                Click="Button_Click"
                Style="{StaticResource AccentButtonStyle}" />
        </Grid>
    </Grid>
</Page>
